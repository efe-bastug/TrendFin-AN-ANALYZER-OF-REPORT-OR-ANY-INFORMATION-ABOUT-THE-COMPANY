# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# PDF Processing Settings
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# OpenAI Model Settings
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_ANSWER_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mini_guru

# Qdrant Vector Database
QDRANT_URL=http://vector:6333
QDRANT_COLLECTION_NAME=pdf_chunks

# Django Settings
DEBUG=1
SECRET_KEY=your_django_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1

# File Upload Settings
MAX_FILE_SIZE=15728640  # 15MB in bytes
MAX_FILES_PER_UPLOAD=10

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development

# Optional: Authentication (for future OAuth implementation)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional: Redis for caching (for future implementation)
# REDIS_URL=redis://redis:6379

# Optional: Sentry for error tracking (for future implementation)
# SENTRY_DSN=your_sentry_dsn_here 